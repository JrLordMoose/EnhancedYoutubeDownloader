<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:EnhancedYoutubeDownloader.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="EnhancedYoutubeDownloader.Views.Dialogs.TutorialDialog"
             x:DataType="vm:TutorialViewModel">

    <Design.DataContext>
        <vm:TutorialViewModel />
    </Design.DataContext>

    <!-- Modern Dialog Card with Shadow Effect -->
    <Border Background="{DynamicResource MaterialPaperBrush}"
            CornerRadius="12"
            MaxWidth="850"
            MaxHeight="600">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Elegant Header with Gradient Feel -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AppAccentBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="32,20">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}"
                              FontSize="22"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource AppOnAccentBrush}"/>
                    <TextBlock Text="Everything you need to know to get started"
                              FontSize="13"
                              Opacity="0.9"
                              Foreground="{DynamicResource AppOnAccentBrush}"/>
                </StackPanel>
            </Border>

            <!-- Scrollable Content Area with Cards -->
            <ScrollViewer Grid.Row="1"
                         Padding="24,16,24,8"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         AllowAutoHide="False">
                <StackPanel Spacing="20" MaxWidth="760">

                    <!-- Quick Start Steps -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Quick Start" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentTextBrush}"/>

                        <!-- Step 1 -->
                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="{DynamicResource AppAccentBrush}" Width="32" Height="32" CornerRadius="16">
                                        <TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Paste a link (or search)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Paste a video, Short, playlist or channel link from any supported site (see below), or type words to search YouTube. Press Enter or click Download. The app fetches the real title and thumbnail first."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}" Margin="44,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 2 -->
                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="{DynamicResource AppAccentBrush}" Width="32" Height="32" CornerRadius="16">
                                        <TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Pick quality, format and where to save" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="MP4 = video that plays everywhere. WebM = smaller video. MP3 = audio only. Choose a quality (Best, 1080p, 720p, 480p, 360p or Audio Only), subtitles and tags, and the save location. Your defaults come from Settings › Downloads. For playlists, tick the videos you want."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}" Margin="44,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 3 -->
                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="{DynamicResource AppAccentBrush}" Width="32" Height="32" CornerRadius="16">
                                        <TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Manage your downloads" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Each download shows progress, speed and time left. Pause, Resume (restarts that download), Cancel, Restart, Delete, or Open the finished file in its folder. Select any title or error and right-click › Copy."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}" Margin="44,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Step 4 -->
                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Background="{DynamicResource AppAccentBrush}" Width="32" Height="32" CornerRadius="16">
                                        <TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="If a site asks you to sign in" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Some videos need a signed-in session (YouTube's &quot;confirm you're not a bot&quot;, private or age-restricted videos, Instagram, Reddit). The app asks automatically. Choose a cookies.txt exported from a browser where you're signed in (for example with the &quot;Get cookies.txt LOCALLY&quot; extension, ideally from a private window). Your cookies stay on this computer."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}" Margin="44,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Supported platforms -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Supported Platforms" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentTextBrush}"/>
                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}">
                                    <Run Text="Works out of the box: " FontWeight="SemiBold"/>
                                    <Run Text="YouTube (videos, Shorts, playlists, channels, youtu.be and m.youtube.com links), TikTok, X / Twitter, Facebook, Dailymotion, Twitch clips, SoundCloud (audio) and direct video file links (.mp4)."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}">
                                    <Run Text="Needs sign-in (cookies.txt): " FontWeight="SemiBold"/>
                                    <Run Text="Instagram, Reddit and Vimeo, plus YouTube videos that are private, age-restricted or blocked by the bot check."/>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}">
                                    <Run Text="Also: " FontWeight="SemiBold"/>
                                    <Run Text="1,800+ other sites supported by yt-dlp. Paste the link and try it. DRM-protected videos (e.g. paid streaming) can't be downloaded."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Settings explained -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Settings Explained" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccentTextBrush}"/>

                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="General" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Theme: " FontWeight="SemiBold"/><Run Text="Light, Dark, or Auto (follows Windows)."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Automatic Updates: " FontWeight="SemiBold"/><Run Text="checks for a new version at startup and asks before installing. &quot;Check for updates now&quot; checks any time."/></TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Downloads" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Parallel Downloads: " FontWeight="SemiBold"/><Run Text="how many download at the same time (the rest wait in line)."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Default Quality / Format / MP3 Quality: " FontWeight="SemiBold"/><Run Text="what the download window starts with; MP3 Quality sets the audio bitrate."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Subtitles: " FontWeight="SemiBold"/><Run Text="download subtitles in your language. Style: Embedded (toggle in your player), Burned-In (always visible), or a separate .srt file. AI Subtitles create them with Whisper when a video has none (slower; downloads a ~74 MB model once)."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Tags: " FontWeight="SemiBold"/><Run Text="adds title, artist and cover art to the file."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Auto-start / Open Folder / Notify When Done: " FontWeight="SemiBold"/><Run Text="start downloads right away, open the folder when one finishes, and show a notification."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Storage: " FontWeight="SemiBold"/><Run Text="default download folder, and where the app keeps its cache (restart after changing)."/></TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialCardBackgroundBrush}" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Advanced" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Authentication: " FontWeight="SemiBold"/><Run Text="the cookies.txt file used for sites that need you signed in (recommended), or browser cookies (only Firefox works on Windows)."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Cache Management: " FontWeight="SemiBold"/><Run Text="shows the size of saved video info and clears it."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Installation: " FontWeight="SemiBold"/><Run Text="where the app is installed (updates go here). Open it in Explorer or run the uninstaller."/></TextBlock>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MaterialBodyBrush}"><Run Text="Reset / About: " FontWeight="SemiBold"/><Run Text="restore every setting to its default, see your version, and check for updates."/></TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="{DynamicResource MaterialDividerBrush}" Margin="0,8"/>

                    <!-- Help Section -->
                    <StackPanel Spacing="16" Margin="0,0,0,60">
                        <TextBlock Text="Need More Help?"
                                  FontSize="18"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource AppAccentTextBrush}"/>

                        <Grid ColumnDefinitions="*,16,*">
                            <!-- GitHub Button -->
                            <Button Grid.Column="0"
                                    Classes="Outline"
                                    Height="48"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding OpenGitHubCommand}"
                                    ToolTip.Tip="View documentation and source code">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="📚" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="GitHub Docs" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Bug Report Button -->
                            <Button Grid.Column="2"
                                    Classes="Outline"
                                    Height="48"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding OpenBugReportCommand}"
                                    ToolTip.Tip="Report bugs or request features">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="🐛" FontSize="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Report Bug" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Clean Footer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource MaterialCardBackgroundBrush}"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="32,16">
                <Grid>
                    <TextBlock Text="🎬 Happy downloading!"
                              VerticalAlignment="Center"
                              FontSize="14"
                              Foreground="{DynamicResource MaterialBodyBrush}"
                              HorizontalAlignment="Left"/>

                    <Button Content="Got It!"
                            Classes="Flat"
                            Height="40"
                            MinWidth="120"
                            FontSize="14"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            IsDefault="True"
                            IsCancel="True"
                            Command="{Binding CloseDialogCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
